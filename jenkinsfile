pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
            }
        }

        stage('Build') {
            steps {
                echo 'Building Docker image...'
                sh 'docker build -t student-management-app .'
            }
        }

        stage('Test') {
            steps {
                echo 'Running application test...'
                sh 'docker run -d --name test-container -p 3000:3000 student-management-app'
                sh 'sleep 5'
                sh 'curl http://localhost:3000/health'
            }
        }

        stage('Push to ECR') {
            steps {
                echo 'Pushing Docker image to Amazon ECR...'

                sh '''
                    aws ecr get-login-password --region us-east-1 | \
                    docker login --username AWS --password-stdin \
                    602440904624.dkr.ecr.us-east-1.amazonaws.com

                    docker tag student-management-app:latest \
                    602440904624.dkr.ecr.us-east-1.amazonaws.com/aws-cicd-project:latest

                    docker push \
                    602440904624.dkr.ecr.us-east-1.amazonaws.com/aws-cicd-project:latest
                '''
            }
        }

        stage('Cleanup') {
            steps {
                sh 'docker stop test-container || true'
                sh 'docker rm test-container || true'
            }
        }
    }

    post {
        success {
            echo 'CI/CD pipeline completed successfully!'
        }

        failure {
            echo 'CI/CD pipeline failed.'
        }
    }
}